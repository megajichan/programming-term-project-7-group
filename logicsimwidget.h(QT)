#ifndef LOGICSIMWIDGET_H
#define LOGICSIMWIDGET_H

#include <QWidget>
#include <QVector>
#include <QPushButton>
#include <QSpinBox>
#include <QComboBox>
#include <QLabel>

class WaveformWidget : public QWidget {
    Q_OBJECT
public:
    explicit WaveformWidget(QWidget *parent = nullptr);
    void setData(const QVector<int>& a, const QVector<int>& b,
                 const QVector<int>& raw, const QVector<int>& out,
                 int gateType, int delayTicks);
    QSize sizeHint() const override { return QSize(640, 280); }

protected:
    void paintEvent(QPaintEvent *event) override;

private:
    QVector<int> sigA, sigB, sigRaw, sigOut;
    int gateType    = 0;
    int delayTicks  = 0;
    static const int TICKS   = 40;
    static const int TICK_NS = 1;
};

class LogicSimWidget : public QWidget {
    Q_OBJECT
public:
    explicit LogicSimWidget(QWidget *parent = nullptr);

private slots:
    void onSimulate();
    void onToggleA(int tick);
    void onToggleB(int tick);
    void onGateChanged(int idx);

private:
    void buildUI();
    void updateToggleButtons();
    QVector<int> computeDelayed(const QVector<int>& raw, int delayTicks);

    static const int TICKS   = 40;
    static const int TICK_NS = 1;

    QVector<int> sigA, sigB;
    int gateType = 0;

    QComboBox        *gateCombo    = nullptr;
    QSpinBox         *delaySpinBox = nullptr;
    WaveformWidget   *waveWidget   = nullptr;
    QWidget          *rowBGroup    = nullptr;
    QVector<QPushButton*> btnA, btnB;
};

#endif // LOGICSIMWIDGET_H
